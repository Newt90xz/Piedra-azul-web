{
  "name": "piedra-azul-web",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma web «Leer para Todos» del Liceo Piedra Azul",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter frontend test"
  }
}
