PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<clave-service-role-solo-backend>
# Voz en tiempo real: servidor de Pocket-TTS (ver frontend/scripts/voz/README.md)
POCKET_TTS_URL=http://127.0.0.1:8000
VOZ_CACHE=.cache-voz

# Comando que levanta Pocket-TTS junto con el backend (así `pnpm dev` deja la voz lista).
# Por defecto: pocket-tts serve --language spanish --host 127.0.0.1 --port 8000 (pocket-tts debe estar en el PATH).
# Ruta completa si se instaló en un entorno virtual, sin comillas; «no» si se levanta aparte.
# POCKET_TTS_COMANDO=C:\ruta\venv\Scripts\pocket-tts.exe serve --language spanish --default-voice voz.safetensors --host 127.0.0.1 --port 8000
utaenv\Scripts\pocket-tts.exe serve --language spanish --default-voice voz.safetensors --host 127.0.0.1 --port 8000
