PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<clave-service-role-solo-backend>
# Voz en tiempo real: servidor de Pocket-TTS (ver frontend/scripts/voz/README.md)
POCKET_TTS_URL=http://localhost:8000
VOZ_CACHE=.cache-voz

# Opcional: comando que levanta Pocket-TTS junto con el backend (así `pnpm dev` deja la voz lista)
# POCKET_TTS_COMANDO=pocket-tts serve --language spanish --default-voice voz.safetensors --port 8000
